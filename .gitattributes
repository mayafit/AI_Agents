# Plugin source and bundle must have LF line endings everywhere so that
# `scripts/build-plugin.js` produces a byte-identical bundle on all platforms
# (Windows/macOS/Linux) regardless of `core.autocrlf`. The build script copies
# skill payloads byte-for-byte, so any CRLF introduced by a checkout would
# leak into the generated bundle and break NFR51 (deterministic staging).
lib/bmad-extension/** text eol=lf
lib/bmad-extension-plugin/** text eol=lf

# Keep the build script itself, its tests, and the manifest template at LF
# for the same reason — the test suite's SHA-256 idempotency check needs the
# script to read the same bytes on every checkout.
scripts/build-plugin.js text eol=lf
test/build-plugin.test.js text eol=lf

# Bug 27.10 — the instruction-block templates consumed by composeInstructionBlock
# (lib/installer.js) are authored with CRLF on Windows. The composer normalizes to
# LF at runtime, but pinning the sources to LF is defense-in-depth so the seams and
# bodies are LF in the working tree regardless of core.autocrlf.
lib/templates/instruction-block-*.template.md text eol=lf

# MIL-498 DID source templates must also stay LF. test/migration-validation.test.js
# (Story 15.8, task 3.Na) asserts lib/mil498-templates/*.md is byte-identical to the
# eol=lf-pinned skill copies under lib/bmad-extension/skills/mil498-*/template.md.
# Without this pin, Windows autocrlf renders the source as CRLF on checkout and the
# byte-identity assertion fails even though the committed blobs are identical (LF).
lib/mil498-templates/** text eol=lf

# Story 31.10 — the Confluence page tree. Pinned to LF because Story 31.9 was
# bitten by exactly this: a suite that passed on the author's checkout and not on
# a checkout with the other line ending. Nothing here is currently broken (the
# suite was run against a CRLF copy of both files and still passed), so this is
# prevention, not a fix — it removes the class rather than the instance. It also
# keeps these two files consistent with each other: they are authored LF while
# `bin/cli.js` around them is CRLF, and a multi-line search across the pair
# silently matching nothing is a real failure mode this story hit while
# mutation-testing.
lib/confluence-page-tree.js text eol=lf
test/project-layout-confluence-page-tree.test.js text eol=lf

# Story 31.15 — the publish trigger. Same reason as the two Story 31.10 pins
# above: the generated TOML block is compared byte-for-byte across regenerations
# and the suite asserts a user's file survives byte-identical, so a checkout that
# rewrote either file's line endings would turn a real invariant into a platform
# coin-flip. `bin/cli.js` around them stays CRLF, which is exactly the mixed-EOL
# pair Story 31.10 recorded as a live failure mode.
lib/confluence-publish-hook.js text eol=lf
test/project-layout-confluence-publish-hook.test.js text eol=lf
